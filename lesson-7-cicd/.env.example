# Какой образ приложения запускать. Имя это твой логин на Docker Hub и имя репозитория,
# тег это версия, которую выкатил пайплайн
APP_IMAGE=your-dockerhub-login/events
APP_TAG=v1.0.0

# Порт, на котором nginx слушает снаружи
HTTP_PORT=8080

# Доступ к базе. Postgres создаёт пользователя и базу с этими именами
# при первом запуске, приложение с теми же значениями к ней подключается
POSTGRES_USER=events
POSTGRES_PASSWORD=change-me
POSTGRES_DB=events

# Сколько событий отдавать в GET /events
EVENT_LIMIT=100

# Уровень логирования приложения: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

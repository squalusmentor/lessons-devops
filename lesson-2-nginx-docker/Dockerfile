# =============================================================================
# Dockerfile — рецепт образа. Каждая инструкция = слой.
#
# Здесь ДВА этапа (multi-stage build):
#   1. builder — ставим Hugo и собираем сайт из урока 1
#   2. runtime — берём чистый nginx и кладём в него ТОЛЬКО результат сборки
# Итоговый образ содержит nginx и готовые html — ни Hugo, ни исходников в нём нет.
# Это ~50 МБ вместо ~400 МБ и меньше поверхности для атаки.
#
# ВАЖНО: контекст сборки — КОРЕНЬ репозитория, а не эта папка.
# Иначе не достать lesson-1-base-web (COPY не умеет выходить за пределы контекста).
# Поэтому пути ниже пишутся от корня, а собирать надо так (из этой папки):
#   docker build -f Dockerfile -t lesson2-web ..
#                                            ^^ вот это и есть контекст
# =============================================================================


# ---------- Этап 1: сборка сайта ----------
# FROM — с какого готового образа начинаем. Образ скачивается из реестра.
# AS builder — даём этапу имя, чтобы потом забрать из него файлы.
#
# Версия ЗАФИКСИРОВАНА (v0.164.0), а не :latest. Иначе сборка, которая работала
# вчера, завтра развалится на новой версии Hugo. В проде теги всегда пинуют.
FROM ghcr.io/gohugoio/hugo:v0.164.0 AS builder

# Рабочая папка внутри образа. Все следующие команды выполняются отсюда.
WORKDIR /src

# COPY <откуда на хосте> <куда в образе>. Копируем проект из урока 1.
COPY lesson-1-base-web/ ./

# ARG — переменная только на время сборки (в готовом образе её нет).
# Значение можно переопределить: docker build --build-arg HUGO_BASEURL=https://site.ru/
ARG HUGO_BASEURL=/

# RUN — выполнить команду при сборке. Результат запекается в слой образа.
# --minify выкидывает из html лишние пробелы и переносы.
RUN hugo --minify --baseURL "${HUGO_BASEURL}"
# Результат лежит в /src/public — забираем его на следующем этапе.


# ---------- Этап 2: то, что поедет в прод ----------
FROM nginx:1.27-alpine

# Убираем дефолтный конфиг "Welcome to nginx!", чтобы он не мешался
RUN rm /etc/nginx/conf.d/default.conf

# Кладём свой. include conf.d/*.conf уже прописан в /etc/nginx/nginx.conf
COPY lesson-2-nginx-docker/nginx/site.conf /etc/nginx/conf.d/site.conf

# --from=builder — забрать файлы из первого этапа.
# /usr/share/nginx/html — стандартный root в образе nginx, он же указан в site.conf
COPY --from=builder /src/public /usr/share/nginx/html

# Документирует, какой порт слушает приложение. Сам по себе ничего не пробрасывает —
# для этого нужен ключ -p при запуске.
EXPOSE 80

# CMD — что запустить при старте контейнера.
# daemon off — не уходить в фон: контейнер живёт ровно столько, сколько живёт
# его главный процесс. Уйдёт nginx в фон — контейнер тут же остановится.
CMD ["nginx", "-g", "daemon off;"]
